{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdeaCard",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "expected_impact": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "title"
  ]
}
